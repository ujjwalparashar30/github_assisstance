generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Resume {
  id          Int      @id @default(autoincrement())
  guestId     String   // optional if user not logged in
  originalName String
  storedName  String
  resumeText  String?   // parsed text
  uploadedAt  DateTime  @default(now())
}

